rules_version = '2';
// Finance Hub - Firestore security rules (Phase 3)
// 1) Only your Google account can read or write.
// 2) Every save is checked: amounts must be numbers, dates must be real YYYY-MM-DD dates,
//    text has length limits, and records can't contain unexpected fields.
// UPLOAD TO FIREBASE WHENEVER THERE ARE CHANGES
// IMPORTANT: replace YOUR_EMAIL@gmail.com below with the Gmail address you sign in with.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "emiele.ariola@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // ---- field checks ----
    function d() { return request.resource.data; }
    function txt(v, n) { return v is string && v.size() <= n; }
    function label(v, n) { return v is string && v.size() > 0 && v.size() <= n; }
    function money(v) { return v is number && v >= 0 && v <= 1000000000; }
    function isDate(v) { return v is string && v.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
    function dateOrBlank(v) { return v == '' || isDate(v); }
    function has(f) { return f in d(); }
    function optTxt(f, n) { return !has(f) || txt(d()[f], n); }
    function optDate(f) { return !has(f) || dateOrBlank(d()[f]); }
    function optTimestamp(f) { return !has(f) || (d()[f] is int && d()[f] >= 0); }
    function fields(required, optional) {
      return d().keys().hasAll(required) && d().keys().hasOnly(required.concat(optional));
    }

    // ---- settings, lists, budget, wallets ----
    match /users/{uid}/meta/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'state'
        && fields(['settings', 'lists', 'budget'], ['wallets'])
        && d().settings is map && d().settings.size() <= 40
        && d().lists is map && d().lists.size() <= 10
        && d().budget is map && d().budget.size() <= 100
        && (!has('wallets') || (d().wallets is list && d().wallets.size() <= 50));
    }

    match /users/{uid}/expenses/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['type', 'amount', 'date'], ['paidFrom', 'wallet', 'note', 'billId', 'billMonth', 'debtId', 'debtInstallmentId', 'budgeted', 'createdAt'])
        && label(d().type, 80) && money(d().amount) && isDate(d().date)
        && (!has('paidFrom') || d().paidFrom in ['Cash Balance', 'Goal Funds'])
        && (!has('budgeted') || d().budgeted is bool)
        && optTimestamp('createdAt')
        && optTxt('wallet', 60) && optTxt('note', 500) && optTxt('billId', 60)
        && optTxt('debtId', 60) && optTxt('debtInstallmentId', 60)
        && (!has('billMonth') || (d().billMonth is string && d().billMonth.matches('20[0-9]{2}-(0[1-9]|1[0-2])')));
    }

    match /users/{uid}/income/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['type', 'amount'], ['date', 'wallet', 'desc', 'covStart', 'covEnd', 'adjPay', 'note', 'createdAt'])
        && label(d().type, 80) && money(d().amount)
        && optDate('date') && optDate('covStart') && optDate('covEnd') && optDate('adjPay')
        && optTxt('wallet', 60) && optTxt('desc', 300) && optTxt('note', 500) && optTimestamp('createdAt');
    }

    match /users/{uid}/savings/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['action', 'account', 'amount', 'date'], ['wallet', 'note', 'toAccount', 'createdAt'])
        && d().action in ['Deposit', 'Withdrawal', 'Transfer'] && label(d().account, 80)
        && money(d().amount) && isDate(d().date)
        && (d().action != 'Transfer' || (label(d().toAccount, 80) && d().toAccount != d().account))
        && (d().action == 'Transfer' || !has('toAccount'))
        && optTxt('wallet', 60) && optTxt('note', 500) && optTimestamp('createdAt');
    }

    match /users/{uid}/transfers/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['from', 'to', 'amount', 'date'], ['note', 'createdAt'])
        && label(d().from, 60) && label(d().to, 60) && d().from != d().to
        && money(d().amount) && isDate(d().date) && optTxt('note', 500) && optTimestamp('createdAt');
    }

    match /users/{uid}/bills/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['name', 'category', 'amount', 'dueDay'], ['src', 'status', 'created', 'skips', 'allotments'])
        && label(d().name, 120) && label(d().category, 80) && money(d().amount)
        && d().dueDay is number && d().dueDay >= 1 && d().dueDay <= 31
        && optTxt('src', 60)
        && (!has('status') || d().status in ['Active', 'Paused'])
        && optDate('created')
        && (!has('skips') || (d().skips is list && d().skips.size() <= 240))
        && (!has('allotments') || (d().allotments is map && d().allotments.size() <= 240));
    }

    match /users/{uid}/goals/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['name', 'target'], ['date'])
        && label(d().name, 120) && money(d().target) && optDate('date');
    }

    match /users/{uid}/debts/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['name', 'medium', 'amount', 'installment'], [])
        && label(d().name, 120) && label(d().medium, 120) && money(d().amount)
        && d().amount > 0 && d().installment is bool;
    }

    match /users/{uid}/debtInstallments/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['debtId', 'amount', 'dueDate', 'sequence'], [])
        && label(d().debtId, 60) && money(d().amount) && d().amount > 0
        && isDate(d().dueDate) && d().sequence is int && d().sequence >= 1 && d().sequence <= 60;
    }

    match /users/{uid}/allocs/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && fields(['goal', 'amount', 'date'], ['note', 'createdAt'])
        && label(d().goal, 60) && money(d().amount) && isDate(d().date) && optTxt('note', 500) && optTimestamp('createdAt');
    }

    match /users/{uid}/adjustments/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && ((fields(['wallet', 'date', 'actual', 'delta'], ['note', 'createdAt']) && label(d().wallet, 60))
          || (fields(['target', 'account', 'date', 'actual', 'delta'], ['note', 'createdAt'])
            && d().target == 'savings' && label(d().account, 80)))
        && isDate(d().date) && money(d().actual)
        && d().delta is number && d().delta >= -1000000000 && d().delta <= 1000000000
        && optTxt('note', 500) && optTimestamp('createdAt');
    }
    // Anything else is denied by default.
  }
}
